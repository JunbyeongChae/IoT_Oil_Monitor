// secrets.h.example
// 이 파일을 secrets.h로 복사한 뒤 실제 값을 채워 넣으세요.
// secrets.h는 .gitignore에 등록되어 있어 커밋되지 않습니다.

#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi 접속 정보
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// 텔레그램 봇 (BotFather에서 발급, 채팅방 ID는 @userinfobot 등으로 확인)
#define BOT_TOKEN "123456789:AA...your_bot_token"
#define CHAT_ID   "123456789"

// 텔레그램 TLS 루트 인증서 (UniversalTelegramBot 예제의 TELEGRAM_CERTIFICATE_ROOT 정의를
// 그대로 붙여넣으세요 - 라이브러리 저장소 examples 폴더에서 확인 가능)
// const char TELEGRAM_CERTIFICATE_ROOT[] PROGMEM = R"EOF( ... )EOF";

#endif
